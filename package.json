{
  "name": "snakes-ladders-mutation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nx serve game-web",
    "build": "nx run game-web:build",
    "preview": "vite preview --config apps/game-web/vite.config.ts",
    "test": "nx run game-web:panda && vitest run",
    "test:watch": "vitest",
    "typecheck": "nx run game-web:panda && tsc --noEmit",
    "lint": "eslint .",
    "tauri": "tauri",
    "android": "tauri android dev",
    "ios": "tauri ios dev",
    "icons": "nx run tooling:icons",
    "verify:ui": "nx run tooling:verify-ui",
    "verify:ui:pages": "nx run tooling:verify-ui-pages",
    "relay": "nx run relay:serve",
    "delegate": "node scripts/delegate.mjs",
    "provision": "bash scripts/provision.sh"
  },
  "dependencies": {
    "@effect-atom/atom": "^0.7.0",
    "@effect-atom/atom-react": "^0.7.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/store": "^0.11.1",
    "@tauri-apps/api": "^2.11.1",
    "effect": "^3.22.2",
    "lucide-react": "1.46.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "^23.2.1",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@pandacss/dev": "1.12.1",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "jsonc-eslint-parser": "^3.3.0",
    "nx": "23.2.1",
    "playwright": "^1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
